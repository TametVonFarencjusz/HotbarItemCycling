Configs: {
	OutlineStyle: {
		Tooltip: ""

		White: {
			Tooltip: ""
			Label: White
		}

		YellowBlue: {
			Label: Yellow/Blue
			Tooltip: ""
		}

		Golden: {
			Label: Golden
			Tooltip: ""
		}

		GreenArrows: {
			Label: Green Arrows
			Tooltip: ""
		}

		YellowBlueArrows: {
			Label: Yellow/Blue Arrows
			Tooltip: ""
		}

		ArrowsInTheCorner: {
			Tooltip: ""
			Label: Arrows In The Corner
		}
	}

	MainConfig: {
		DisplayName: Main Config

		NoCyclingWhileUsingItem: {
			Tooltip:
				'''
				Prevent player from cycling items while using an item.
				It prevent a bug similiar to Attribute Swapping from Minecraft.
				Turn off at own risk.
				'''
			Label: No Cycling While Using Item
		}

		SkipUnconnectedItems: {
			Tooltip: Marked as favorited items in column have to be directily connected to hotbar or indirectly by other favorited items.
			Label: Skip Unconnected Favorited Items
		}

		Headers: {
			InGame: In Game
			Outlines: Outlines
		}

		OutlineStylePicker: {
			Label: Outline Style
			Tooltip: Choose Outline Style.
		}

		OutlineStyleColorSwap: {
			Label: Swap Outline Style on Selected Items
			Tooltip:
				'''
				Swap the primary outline color with the secondary color.
				Some styles have additional colors to better see them on blue and yellow item slot.
				Primary color is used for blue item slot.
				Secondary color is used for yelow item slot.
				Mod Config must be saved for the changes to appear in the Preview.
				'''
		}

		OutlineStyleDontChange: {
			Label: Don't Change Outline Style on Selected Items
			Tooltip:
				'''
				Prevent the outline color from changing from the primary color to the secondary color.
				Some styles have additional colors to better see them on blue and yellow item slot.
				Primary color is used for blue item slot.
				Secondary color is used for yelow item slot.
				Mod Config must be saved for the changes to appear in the Preview.
				'''
		}

		OutlineVisibility: {
			Tooltip:
				'''
				Set Outline visibility.
				Mod Config must be saved for the changes to appear in the Preview.
				'''
			Label: Outline Visibility
		}
	}

	ItemPreviewConfig: {
		ShowItemStack: {
			Label: Show number next to Item:
			Tooltip: Show number next to Item. A number can indicate how many items are stacked, how much ammunition a weapon has, etc.
		}

		BuffPosition: {
			Label: Buff Position Update:
			Tooltip:
				'''
				Set how buffs should be moved be moved when Next Item Preview is shown.
				Disable - Buffs won't be moved. Preview items may cover some buffs. Should be used with any other mod that change buff position.
				Dynamic - Buffs will be dynamically moved if the item preview would cover them.
				Static - Buffs will be moved so that the preview elements do not cover them.
				'''
		}

		ItemMaxCount: {
			Label: Max Count of Item in Preview:
			Tooltip: Limit how many items should be shown below items in hotbar.
		}

		ItemPreviewStyle: {
			Label: Item Preview Style:
			Tooltip: ""
		}

		Headers.ItemPreviewBeta: Item Preview (Beta)
		DisplayName: Next Item Preview Config
	}

	ItemPreviewBuffPosition: {
		Static: {
			Tooltip: ""
			Label: Static
		}

		Dynamic: {
			Tooltip: ""
			Label: Dynamic
		}

		Disabled: {
			Tooltip: ""
			Label: Disabled
		}

		Tooltip: ""
	}

	ItemPreviewStyle: {
		All: {
			Tooltip: ""
			Label: All
		}

		Single: {
			Tooltip: ""
			Label: Single
		}

		Disabled: {
			Tooltip: ""
			Label: Disabled
		}

		Tooltip: ""
	}
}
